# Alamat backend (NestJS). Browser memanggil /api/v1 di frontend, lalu Next.js meneruskannya ke sini
# sehingga tidak perlu pengaturan CORS. Ganti bila backend berjalan di server/port lain.
API_URL=http://localhost:4000

# Tampilkan tombol akun demo di halaman login (hanya untuk uji coba dengan data seed). Produksi: false
NEXT_PUBLIC_SHOW_DEMO=true
